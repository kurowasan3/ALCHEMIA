     }
    ]
   }
  ]
 },
 "figures": [],
 "answer": {
  "parts": [
   {
    "id": "1",
    "tex": "$\\ce{[Zn(NH3)4]^2+}$",
    "grading": "語{[Zn(NH3)4]^2+|[Zn(NH3)4]2+|テトラアンミン亜鉛(II)イオン}"
   },
   {
    "id": "2",
    "tex": "正四面体形",
    "grading": "選ぶ{直線形|正方形|正四面体形|正八面体形}=3"
   }
  ]
 },
 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "$\\ce{Zn(OH)2 + 4NH3 -> [Zn(NH3)4]^2+ + 2OH-}$．配位数 4 でも，$\\ce{[Cu(NH3)4]^2+}$ は正方形，$\\ce{[Zn(NH3)4]^2+}$ は正四面体形．"
    }
   ]
  }
