 "answer": {
  "parts": [
   {
    "id": "main",
    "tex": "硫酸 ＞ 炭酸 ＞ ケイ酸",
    "grading": "並べる{ケイ酸|炭酸|硫酸}=3>2>1"
   }
  ]
 },
 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "ケイ酸ナトリウム水溶液に CO₂ を通じるとケイ酸が沈殿する（$\\ce{Na2SiO3 + CO2 + H2O -> H2SiO3 + Na2CO3}$）ので，炭酸はケイ酸より強い．炭酸塩に硫酸を加えると CO₂ が出るので，硫酸は炭酸より強い．"
    }
   ]
  }
 ],
