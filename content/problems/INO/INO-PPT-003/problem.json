 "statement": {
  "blocks": [
   {
    "type": "text",
    "tex": "塩化鉄(III)水溶液にチオシアン酸カリウム水溶液を加えると，溶液は何色になるか．"
   }
  ]
 },
 "figures": [],
 "answer": {
  "parts": [
   {
    "id": "main",
    "tex": "血赤色",
    "grading": "語{血赤|血赤色|赤|赤色|濃赤色}"
   }
  ]
 },
 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "$\\ce{Fe^3+ + SCN- -> [Fe(SCN)]^2+}$ により血赤色の溶液になる（沈殿はしない）．$\\ce{Fe^2+}$ では変化しないので，$\\ce{Fe^3+}$ の検出に使う．"
    }
   ]
  }
 ],
