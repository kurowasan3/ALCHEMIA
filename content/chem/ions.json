 "systematic": [
  {
   "step": 1,
   "group": "第1属",
   "reagent": "希塩酸を加える",
   "ppt": [
    "AgCl",
    "PbCl2"
   ],
   "ions": [
    "Ag+",
    "Pb^2+"
   ],
   "note": "塩化物が沈殿する。PbCl₂ は熱水に溶けるので、熱水を加えて AgCl と分ける"
  },
  {
   "step": 2,
   "group": "第2属",
   "reagent": "酸性のまま硫化水素を通じる",
   "ppt": [
    "CuS",
    "CdS"
   ],
   "ions": [
    "Cu^2+",
    "Cd^2+"
   ],
   "note": "イオン化傾向の小さい金属（Sn より小さい）の硫化物は酸性でも沈殿する"
  },
  {
   "step": 3,
   "group": "第3属",
   "reagent": "煮沸して H₂S を追い出し、希硝酸で Fe²⁺ を Fe³⁺ に酸化してから、NH₄Cl と過剰のアンモニア水を加える",
   "ppt": [
    "Fe(OH)3",
    "Al(OH)3"
   ],
   "ions": [
    "Fe^2+",
    "Fe^3+",
    "Al^3+"
   ],
   "note": "煮沸は H₂S が硝酸で酸化されて S が出るのを防ぐため。Fe(OH)₂ のままだと沈殿しきらないので Fe³⁺ にしておく"
  },
  {
   "step": 4,
   "group": "第4属",
   "reagent": "塩基性で硫化水素を通じる",
   "ppt": [
    "ZnS",
    "MnS",
    "NiS"
   ],
   "ions": [
    "Zn^2+",
    "Mn^2+",
    "Ni^2+"
   ],
   "note": "中程度のイオン化傾向の金属の硫化物は、S²⁻ の濃度が大きい塩基性で沈殿する"
  },
  {
   "step": 5,
   "group": "第5属",
   "reagent": "炭酸アンモニウム水溶液を加える",
   "ppt": [
    "CaCO3",
    "SrCO3",
    "BaCO3"
   ],
   "ions": [
    "Ca^2+",
    "Sr^2+",
    "Ba^2+"
   ],
   "note": "アルカリ土類金属（Be・Mg を除く）の炭酸塩"
  },
  {
   "step": 6,
   "group": "第6属",
   "reagent": "ろ液に残る（炎色反応などで確かめる）",
   "ppt": [],
   "ions": [
    "Mg^2+",
    "Na+",
    "K+",
    "Li+"
   ],
   "note": "Na⁺・K⁺・Li⁺ は炎色反応で見分ける"
  }
 ]
