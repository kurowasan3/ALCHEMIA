 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "アセチレン → アセトアルデヒド：水（HgSO₄ 触媒）（付加）　$\\ce{CH#CH + H2O -> CH3CHO}$．不安定なビニルアルコール CH₂=CHOH を経て異性化する"
    },
    {
     "type": "text",
     "tex": "アセトアルデヒド → 酢酸：酸化（O₂・触媒、K₂Cr₂O₇ など）（酸化）　$\\ce{2CH3CHO + O2 -> 2CH3COOH}$"
    }
   ]
  }
 ],
