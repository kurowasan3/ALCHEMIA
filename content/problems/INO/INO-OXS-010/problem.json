 "statement": {
  "blocks": [
   {
    "type": "text",
    "tex": "硫黄 $32\\,\\mathrm{kg}$ がすべて硫酸になるとすると，質量パーセント濃度 98 % の濃硫酸は何 kg 得られるか．S = 32，H₂SO₄ = 98 とする．"
   }
  ]
 },
 "figures": [],
 "answer": {
  "parts": [
   {
    "id": "main",
    "tex": "$100\\,\\mathrm{kg}$",
    "grading": "約{100|3} [kg]"
   }
  ]
 },
 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "S 1 mol から H₂SO₄ 1 mol．$32\\,\\mathrm{kg}$ は $1.0\\times10^3\\,\\mathrm{mol}$，H₂SO₄ 98 kg．98 % の濃硫酸では $98/0.98=100\\,\\mathrm{kg}$．"
    }
   ]
  }
 ],
