   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "全体の反応 $\\ce{NH3 + 2O2 -> HNO3 + H2O}$ より，NH₃ 1 mol から HNO₃ 1 mol．NH₃ $1.7\\times10^6/17=1.0\\times10^5\\,\\mathrm{mol}$，HNO₃ $1.0\\times10^5\\times63\\,\\mathrm g=6.3\\,\\mathrm t$．"
    }
   ]
  }
