   {
    "id": "main",
    "tex": "$64$",
    "grading": "約{64|2}"
   }
  ]
 },
 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "反応した H₂・I₂ は 0.80 mol ずつ．平衡時 H₂ 0.20，I₂ 0.20，HI 1.6 mol．$K=\\dfrac{1.6^2}{0.20\\times0.20}=64$（体積は約分される）．"
    }
   ]
  }
 ],
