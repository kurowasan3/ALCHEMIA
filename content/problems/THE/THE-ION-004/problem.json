 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "混合で濃度は半分：$[\\mathrm{Ag^+}]=[\\mathrm{Cl^-}]=1.0\\times10^{-4}$．積は $1.0\\times10^{-8}>K_{sp}$ なので，積が $K_{sp}$ になるまで AgCl が沈殿する．"
    }
   ]
  }
