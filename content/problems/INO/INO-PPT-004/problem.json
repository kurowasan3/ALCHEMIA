    "tex": "$\\ce{Al(OH)3}$（白色）",
    "grading": "語{Al(OH)3|水酸化アルミニウム}"
   },
   {
    "id": "2",
    "tex": "$\\ce{[Al(OH)4]-}$",
    "grading": "語{[Al(OH)4]-|テトラヒドロキシドアルミン酸イオン}"
