 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "結合に極性があっても，分子の形が対称（CO₂ 直線形，CH₄・CCl₄ 正四面体形）だと極性が打ち消し合って無極性分子になる．H₂O（折れ線形）・NH₃（三角錐形）は打ち消されない．"
    }
   ]
  }
 ],
