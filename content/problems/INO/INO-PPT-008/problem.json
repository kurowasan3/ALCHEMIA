    "tex": "$\\ce{Ag+}$，$\\ce{Cu^2+}$，$\\ce{Zn^2+}$，$\\ce{Ni^2+}$",
    "grading": "すべて選ぶ{$\\ce{Ag+}$|$\\ce{Cu^2+}$|$\\ce{Zn^2+}$|$\\ce{Al^3+}$|$\\ce{Fe^3+}$|$\\ce{Ni^2+}$}=1,2,3,6"
   }
  ]
 },
