    "type": "text",
    "tex": "グルコース $90.0\\,\\mathrm g$ がすべてアルコール発酵した．原子量は H = 1.0，C = 12，O = 16 とする．"
   },
   {
    "type": "parts",
    "items": [
     {
      "id": "1",
      "tex": "反応式 $\\ce{C6H12O6 ->}\\ \\boxed{\\,a\\,}\\,\\ce{C2H5OH} + \\boxed{\\,b\\,}\\,\\ce{CO2}$ の係数 a，b を答えよ．"
     },
     {
      "id": "2",
      "tex": "生じるエタノールは何 g か．"
     }
    ]
   }
  ]
 },
 "figures": [],
 "answer": {
  "parts": [
   {
    "id": "1",
    "tex": "a = 2，b = 2",
    "grading": "a：2 ; b：2"
   },
   {
    "id": "2",
    "tex": "$46\\,\\mathrm g$",
    "grading": "約{46|3} [g]"
