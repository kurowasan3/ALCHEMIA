    "grading": "選ぶ{水（HgSO₄ 触媒）|H₂（Pt・Ni 触媒）|HCl（触媒）|Br₂}=1"
   },
   {
    "id": "4",
    "tex": "ビニルアルコール",
    "grading": "語{ビニルアルコール|CH2=CHOH}"
