 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "$\\ce{H2S}$ は酸性なので塩基性のソーダ石灰と反応する．また還元性があり，酸化作用をもつ濃硫酸に酸化される（$\\ce{H2SO4 + H2S -> S + SO2 + 2H2O}$）．中性の塩化カルシウムを使う．"
    }
   ]
  }
 ],
