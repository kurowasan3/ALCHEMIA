 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "両性金属は Al・Zn・Sn・Pb（「ああすんなり」）．例：$\\ce{2Al + 2NaOH + 6H2O -> 2Na[Al(OH)4] + 3H2}$．ただし Pb は塩酸・希硫酸とは表面に難溶性の塩（PbCl₂・PbSO₄）ができて溶けにくい．"
    }
   ]
  }
 ],
