 "statement": {
  "blocks": [
   {
    "type": "text",
    "tex": "硫酸銅(II)五水和物 $\\ce{CuSO4.5H2O}$（式量 249.5）を用いて，$0.100\\,\\mathrm{mol/L}$ の硫酸銅(II) 水溶液を $500\\,\\mathrm{mL}$ つくるには，五水和物が何 g 必要か．"
   }
  ]
 },
 "figures": [],
 "answer": {
  "parts": [
   {
    "id": "main",
    "tex": "$12.5\\,\\mathrm g$",
    "grading": "約{12.48|3} [g]"
   }
  ]
 },
 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "必要な $\\ce{CuSO4}$ は $0.100\\times0.500=0.0500\\,\\mathrm{mol}$．五水和物 1 mol から CuSO₄ 1 mol なので，$0.0500\\times249.5=12.5\\,\\mathrm g$．"
    }
   ]
  }
 ],
