 "figures": [],
 "answer": {
  "parts": [
   {
    "id": "main",
    "tex": "$\\ce{Cl2}$，$\\ce{HCl}$，$\\ce{CO2}$，$\\ce{NO2}$，$\\ce{SO2}$，$\\ce{H2S}$",
    "grading": "すべて選ぶ{$\\ce{H2}$|$\\ce{O2}$|$\\ce{Cl2}$|$\\ce{HCl}$|$\\ce{NH3}$|$\\ce{CO2}$|$\\ce{NO}$|$\\ce{NO2}$|$\\ce{SO2}$|$\\ce{H2S}$|$\\ce{CH4}$}=3,4,6,8,9,10"
   }
  ]
 },
 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "水に溶けにくい気体は水上置換．水に溶けやすく空気より軽い（分子量 < 29）気体は上方置換（$\\ce{NH3}$ だけ），空気より重い気体は下方置換．$\\ce{NO}$ は空気中の $\\ce{O2}$ と反応するので水上置換．"
    }
   ]
  }
 ],
