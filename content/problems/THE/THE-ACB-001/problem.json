 "statement": {
  "blocks": [
   {
    "type": "text",
    "tex": "次の反応で，下線を引いた分子（水）は酸・塩基のどちらとしてはたらいているか．"
   },
   {
    "type": "parts",
    "items": [
     {
      "id": "1",
      "tex": "$\\ce{NH3 + H2O <=> NH4+ + OH-}$ の $\\ce{H2O}$"
     },
     {
      "id": "2",
      "tex": "$\\ce{HCl + H2O -> H3O+ + Cl-}$ の $\\ce{H2O}$"
     }
    ]
   }
  ]
 },
 "figures": [],
 "answer": {
  "parts": [
   {
    "id": "1",
    "tex": "酸",
    "grading": "選ぶ{酸|塩基}=1"
   },
   {
    "id": "2",
    "tex": "塩基",
    "grading": "選ぶ{酸|塩基}=2"
   }
  ]
 },
 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "(1) H₂O は NH₃ に H⁺ を与えている → 酸．(2) H₂O は HCl から H⁺ を受け取っている → 塩基．水は相手によって酸にも塩基にもなる．"
    }
   ]
  }
 ],
