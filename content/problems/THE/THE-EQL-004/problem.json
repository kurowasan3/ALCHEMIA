   "blocks": [
    {
     "type": "text",
     "tex": "水素が x mol 生じるとすると，I₂ も x mol，HI は $2.0-2x$ mol．$\\dfrac{(2.0-2x)^2}{x^2}=64$ より $\\dfrac{2.0-2x}{x}=8$，$x=0.20$．逆向きから始めても同じ平衡に達する．"
    }
   ]
  }
